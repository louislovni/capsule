+void geometry(unsigned w,unsigned h);
+// ---- EXPAND (Capsule): the overworld's 3D drawn past the top screen's sides, to a wide phone's edges ----
+// The frontend's panel ("pokedaisy_panel", WxH) sets the frame: 384 rows, as wide as the panel's shape, the one-screen
+// stage (512 x 384, the DS's 2x) in the middle. On the field the margins are the 3D of two slice engines - the left and
+// right neighbours of the screen, fed every polygon the game submits (Gpu3D::wide); elsewhere they are black.
+namespace wide {
+constexpr int OVERLAP=4;      // a slice reaches this far into the screen (its own edge isn't shown)
+constexpr int MAX_MARGIN=248; // DS pixels each side
+int margin=0;                 // DS pixels each side; 0 = off
+unsigned outW=512;            // the frame's width
+std::unique_ptr<ds::gpu::Gpu3D> slices[2];   // left, right
+std::string panel;
+uint16_t out[(512+4*MAX_MARGIN)*384];
+// The HUD over the whole wide frame (DS pixels, 2x on the frame): drawn by present, laid on by emit; 0 = none.
+uint32_t hud[(256+2*MAX_MARGIN)*192];
+int hudW=0;
+
+void submit(ds::gpu::Gpu3D& g,const ds::gpu::Vertex* const* v,int n,bool facing,void*){
+  for(int k=0;k<2;++k){
+    if(!slices[k])continue;
+    const int sx=k?1:-1;
+    ds::gpu::Vertex cv[4];
+    bool allL=true,allR=true,allT=true,allB=true;
+    for(int i=0;i<n;++i){
+      cv[i]=*v[i];
+      const int64_t w=cv[i].pos[3]&0x00FFFFFF;
+      // The slice left of the screen is clip-space x in [-3w,-w]: moved by +2w (a little less: OVERLAP pixels) it's [-w,w].
+      const int64_t x=int64_t(cv[i].pos[0])-sx*(w*(256-OVERLAP)/128);
+      cv[i].pos[0]=int32_t(x);
+      allL&=x<-w; allR&=x>w; allB&=cv[i].pos[1]<-w; allT&=cv[i].pos[1]>w;
+      if(w<=0)allL=allR=allT=allB=false;
+    }
+    if(allL||allR||allT||allB)continue;
+    // Only what the margin shows: the slice's columns past [256 - OVERLAP - margin] (left) or before [OVERLAP + margin]
+    // (right), a few more for edge marking. Clip-space x = (2 sx / 256 - 1) w.
+    bool unseen=true;
+    const int64_t limit=k?OVERLAP+margin+4:256-OVERLAP-margin-4;
+    for(int i=0;i<n&&unseen;++i){
+      const int64_t w=cv[i].pos[3]&0x00FFFFFF,x=cv[i].pos[0];
+      if(w<=0){unseen=false;break;}
+      unseen=k?x*128>(limit-128)*w:x*128<(limit-128)*w;
+    }
+    if(unseen)continue;
+    slices[k]->wide_add(g,cv,n,facing);
+  }
+}
+void swap(ds::gpu::Gpu3D& g,void*){for(auto& s:slices)if(s)s->wide_swap(g);}
+void latched(ds::gpu::Gpu3D& g,void*){for(auto& s:slices)if(s)s->wide_render(g);}
+
+void stop(){
+  if(nds){auto& g=nds->gpu3d;g.wide=ds::gpu::Gpu3D::WideHooks{};}
+  for(auto& s:slices)s.reset();
+}
+void start(){
+  if(!nds||margin<=0)return;
+  for(auto& s:slices)if(!s)s=std::make_unique<ds::gpu::Gpu3D>(*nds);
+  auto& g=nds->gpu3d;
+  g.wide.submit=submit;g.wide.swap=swap;g.wide.latched=latched;g.wide.user=nullptr;
+  g.wide.box[0]=g.wide.box[1]=margin+4;g.wide.box[2]=g.wide.box[3]=0;
+}
+// The panel asked for now: the frame's width and the margins, the slices on or off.
+void read_panel(bool force){
+  retro_variable var{"pokedaisy_panel",nullptr};
+  const std::string value=environment(RETRO_ENVIRONMENT_GET_VARIABLE,&var)&&var.value?var.value:"";
+  if(!force&&value==panel)return;
+  panel=value;
+  int w=0,h=0,m=0;
+  if(std::sscanf(value.c_str(),"%dx%d",&w,&h)==2&&w>0&&h>0&&w*3>h*4){
+    // 384 rows; the width the panel's shape gives, in whole DS pixels each side.
+    const int want=384*w/h;
+    m=std::clamp((want-512)/4,0,MAX_MARGIN);
+  }
+  if(m==margin&&!force)return;
+  margin=m;outW=512+4*m;
+  stop();
+  if(margin>0&&game)start();
+}
+// A 3D colour (RGB666, alpha in bits 24-28) as the top screen shows it: through engine A's master brightness.
+uint16_t shade(uint32_t c,uint16_t mb){
+  uint32_t r=c&63,g=(c>>8)&63,b=(c>>16)&63;
+  const uint32_t mode=mb>>14,f=std::min<uint32_t>(mb&31,16);
+  if(mode==1){r+=((63-r)*f)>>4;g+=((63-g)*f)>>4;b+=((63-b)*f)>>4;}
+  else if(mode==2){r-=(r*f+15)>>4;g-=(g*f+15)>>4;b-=(b*f+15)>>4;}
+  return uint16_t(((r>>1)<<11)|(g<<5)|(b>>1));
+}
+}
+
+// The frame out: as it is, or in the middle of the wide one.
+void emit(const uint16_t* px,bool field3D){
+  if(wide::margin<=0){geometry(512,384);video(px,512,384,512*2);return;}
+  const unsigned W=wide::outW,M2=2*wide::margin;
+  geometry(W,384);
+  field3D=field3D&&wide::slices[0]&&wide::slices[1]&&wide::slices[0]->wide_ready()&&wide::slices[1]->wide_ready();
+  uint16_t mb=0;
+  for(const auto& e:nds->gpu.engine)if(e.screen()==0)mb=e.master_bright();
+  for(unsigned y=0;y<384;++y){
+    uint16_t* row=wide::out+y*W;
+    std::memcpy(row+M2,px+y*512,512*2);
+    if(!field3D){std::memset(row,0,M2*2);std::memset(row+M2+512,0,M2*2);continue;}
+    const uint32_t* left=wide::slices[0]->wide_line(y/2);
+    const uint32_t* right=wide::slices[1]->wide_line(y/2);
+    const uint16_t edgeL=px[y*512],edgeR=px[y*512+511];
+    // The DS outlines the 3D where the screen cuts it (edge marking): a dark line once the picture goes on past it.
+    // The screen's outer column takes the slice's own pixel there - where the next one in shows the slice's colour
+    // too, so it's the 3D and not a text box or the HUD over it.
+    auto near=[](uint16_t a,uint16_t b){
+      const int dr=int(a>>11)-int(b>>11),dg=int((a>>5)&63)-int((b>>5)&63),db=int(a&31)-int(b&31);
+      return std::abs(dr)<=4&&std::abs(dg)<=8&&std::abs(db)<=4;
+    };
+    {
+      const uint32_t in=left[256-wide::OVERLAP+1],edge=left[256-wide::OVERLAP];
+      if(((in>>24)&31)&&((edge>>24)&31)&&near(px[y*512+2],wide::shade(in,mb)))
+        row[M2]=row[M2+1]=wide::shade(edge,mb);
+      const uint32_t inR=right[wide::OVERLAP-2],edgeRc=right[wide::OVERLAP-1];
+      if(((inR>>24)&31)&&((edgeRc>>24)&31)&&near(px[y*512+509],wide::shade(inR,mb)))
+        row[M2+510]=row[M2+511]=wide::shade(edgeRc,mb);
+    }
+    for(unsigned X=0;X<M2;++X){
+      // Left margin: DS x = X/2 - margin, the left slice's pixel x + 252.
+      const int x=int(X/2)-wide::margin+(256-wide::OVERLAP);
+      const uint32_t c=left[std::clamp(x,0,255)];
+      row[X]=(c>>24)&31?wide::shade(c,mb):edgeL;
+      const int xr=int(X/2)+256-(256-wide::OVERLAP);
+      const uint32_t cr=right[std::clamp(xr,0,255)];
+      row[M2+512+X]=(cr>>24)&31?wide::shade(cr,mb):edgeR;
+    }
+  }
+  if(wide::hudW==int(W/2)){
+    for(unsigned y=0;y<384;++y){
+      const uint32_t* src=wide::hud+(y/2)*wide::hudW;
+      uint16_t* row=wide::out+y*W;
+      for(unsigned x=0;x<W;++x){
+        const uint32_t p=src[x/2];
+        if(p==QUICK_CLEAR)continue;
+        const unsigned a=p>>24?p>>24:255;
+        const uint16_t old=row[x];
+        unsigned r=(old>>11&31)*255/31,g=(old>>5&63)*255/63,b=(old&31)*255/31;
+        r=(((p>>16)&255)*a+r*(255-a))/255;
+        g=(((p>>8)&255)*a+g*(255-a))/255;
+        b=((p&255)*a+b*(255-a))/255;
+        row[x]=ds_rgb565((r<<16)|(g<<8)|b);
+      }
+    }
+  }
+  wide::hudW=0;
+  video(wide::out,W,384,W*2);
+}
